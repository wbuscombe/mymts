# Operator-specific deploy targets for the scripts/ tooling.
#
# Copy this file to `scripts/deploy.local.env` (gitignored) and fill in your
# real values. The deploy/probe scripts source it automatically. This keeps
# host names, IPs, and paths OUT of the committed scripts — committed scripts
# carry only generic placeholders.
#
# NEVER commit deploy.local.env.

# adb target — your Android TV box (used by deploy-app.sh, soak.sh,
# validate-fixture.sh, probe-tile-count.sh):
export MYMTS_DEPLOY_DEVICE="192.0.2.10:5555"          # <tv-box-ip>:5555

# Helper host — SSH target + deploy path (used by deploy-helper.sh):
export MYMTS_NAS_HOST="my-helper-host"                # ssh alias or user@host
export MYMTS_HELPER_REMOTE_PATH="/srv/mymts-helper"   # deploy dir on the host

# Helper base URL for the probe/diagnostic scripts (LAN):
export MYMTS_PROBE_HELPER_URL="http://192.0.2.20:8091"   # http://<helper-ip>:<port>
