# Release signing — Stage 6.
#
# Copy this file to `app/keystore.properties` and fill in the four values
# for YOUR keystore. The real file is gitignored; this template is the
# source of truth for what the operator must supply.
#
# Generating a fresh keystore (one-time, for v1.0.0):
#
#   keytool -genkeypair -v \
#       -keystore mymts-release.jks \
#       -alias mymts \
#       -keyalg RSA -keysize 4096 -validity 10000 \
#       -dname "CN=MyMTS,OU=Operator,O=MyMTS,L=,S=,C=US"
#
# Store the keystore in `~/.keystores/` (or wherever the operator's standard
# secrets directory is). DO NOT put it inside the repo. The `MYMTS_RELEASE_STORE_FILE`
# value below points at it by absolute path; that path lives only in the
# untracked `keystore.properties` file the operator writes locally.
#
# All four values can ALSO be supplied as environment variables of the
# same name — useful for CI or a fresh clone. The file wins when both
# are present.
#
# Loss of the keystore means losing the ability to push updates to existing
# installs (the new build would have a different signing identity → Android
# would refuse the update). Back it up off-device.

MYMTS_RELEASE_STORE_FILE=/absolute/path/to/mymts-release.jks
MYMTS_RELEASE_STORE_PASSWORD=replace-with-real-password
MYMTS_RELEASE_KEY_ALIAS=mymts
MYMTS_RELEASE_KEY_PASSWORD=replace-with-real-password
