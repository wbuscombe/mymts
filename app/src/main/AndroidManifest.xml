<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions kept to the strict minimum (Trust Bar A4 — no ambient
      authority). Network access to play HLS, plus the kiosk autostart +
      foreground-service set for MyMTS's own-the-box ambient-wall role
      (Model A). The foreground service + boot receiver only *act* when
      kiosk mode is enabled on-device (opt-in, off by default) — holding
      the permissions does not start anything on a non-kiosk box.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android TV ("leanback") — required so the app appears in the TV
      launcher with a D-pad-first activity.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MyMtsApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/ic_launcher_foreground"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyMTS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Kiosk foreground service (own-the-box ambient wall, Model A).
          SPECIAL_USE: the long-running display-owner role doesn't map to
          a domain foreground type; the property below is the required
          justification. Only started when kiosk mode is opt-in enabled.
        -->
        <service
            android:name=".kiosk.KioskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="MyMTS ambient news/markets/sports wall — sole-kiosk display owner on a dedicated Onn box (Model A); keeps the wall resident + foregrounded for unattended long-uptime operation." />
        </service>

        <!--
          Boot receiver — relaunches MyMTS after a reboot/power-cycle.
          No-op unless kiosk mode is enabled (KioskPolicy.shouldStartOnBoot),
          so a non-kiosk install (e.g. on .182) never autostarts.
        -->
        <receiver
            android:name=".kiosk.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
