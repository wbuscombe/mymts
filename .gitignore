*.ap_
*.dex
*.class
release/
debug/
proguard/
*.keystore
*.jks
keystore.properties

# Helper TLS material — private keys NEVER in repo. The public cert
# *is* in app/src/main/res/raw/helper_cert.pem because the app trusts
# it as a pinned trust anchor; only the private key (helper-side) is
# secret. Belt-and-braces: exclude any helper.key / *.pem file outside
# the app trust path.
*.key
helper/**/*.crt
helper/**/*.pem
!app/src/main/res/raw/helper_cert.pem

# Java / Kotlin
*.log
hs_err_pid*

# Node (helper toolchain, just in case)
node_modules/
dist/
.npm/

# Python (helper)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local env / secrets — placeholder; real .env never enters the repo
.env
.env.*
!.env.example
*.local

# Local archive — keeps source zips and reference material outside the repo tree
.archive/

# Build/release artifacts
*.zip
*.tar
*.tar.gz
*.tgz

# Coverage / test artifacts
coverage/
*.lcov
htmlcov/
.coverage

# Soak-run raw event captures. These can grow tens-to-hundreds of MB per
# run and are regenerable from the harness. The committed per-run record is
# the small files (meta.json, end.json, runner.log, meminfo.csv, device.txt)
# plus the parsed summary in the finding doc.
docs/findings/runs/**/events.log

# Re-include runner.log inside run directories — it's small, captures the
# host-side timeline, and the broader *.log rule above would otherwise
# exclude it.
!docs/findings/runs/**/runner.log

# Operator-local operational runbooks (deploy/provisioning/rotation/recovery).
# Environment-specific: host names, IPs, paths, device inventory live ONLY here.
docs/ops-local/
