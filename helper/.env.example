# Copy to .env (which is gitignored) and fill in. Never commit the real .env.
# EVERY value here is OPTIONAL: the helper boots from a fresh clone with no .env
# at all (safe defaults). These are operational knobs + optional TLS paths — the
# only "secrets" are the TLS cert/key, and only their PATHS live here (the files
# themselves stay out of git). This template mirrors the env vars config.py reads.

# Demo / offline mode: when 1, the helper does no live external work and
# returns synthetic data. Wires up the operator's phantom-mode standard so
# the CI and onboarding can run with zero outbound traffic.
PHANTOM_MODE=0

# Build identity. Injected at container build time. Do not set locally.
BUILD_SHA=
BUILD_VERSION=

# Listen port (internal-only; the helper is never directly exposed to the
# public internet — it sits behind the NAS network).
PORT=8091

# Log level: debug | info | warning | error
LOG_LEVEL=info

# --- Tuning knobs (each has a safe default; uncomment only to override) ---

# SQLite DB location. A container mounts a writable /data volume; a local run
# (clean clone / demo) has no writable /data, so the helper auto-falls-back to a
# per-user dir ($XDG_DATA_HOME or ~/.local/share/mymts-helper) — no config needed
# to boot. DATA_DIR overrides either way. Default: /data (or the per-user fallback).
# DATA_DIR=/data

# Feed (RSS) poll interval, seconds — how often headlines refresh. Default 300 (5m).
# FEED_POLL_INTERVAL_SECONDS=300
# Headline retention before pruning, days. Default 14.
# FEED_RETENTION_DAYS=14
# Channel liveness probe interval, seconds (is each HLS stream up?). Default 1800 (30m).
# CHANNEL_PROBE_INTERVAL_SECONDS=1800
# yt-dlp per-extraction socket timeout, seconds, for kind='youtube' channels
# (resolve YouTube /live -> HLS). Default 25. Egress is residential, never PIA.
# YOUTUBE_RESOLVE_TIMEOUT_SECONDS=25
# Markets ticker poll interval, seconds (Yahoo Finance + CoinGecko, keyless). Default 120.
# MARKETS_POLL_INTERVAL_SECONDS=120
# Sports ticker poll interval, seconds (ESPN scoreboard, keyless). Default 180.
# SPORTS_POLL_INTERVAL_SECONDS=180

# --- TLS (Stage 6, optional). Set ALL THREE to also serve HTTPS on a second
#     listener (same app instance); a half-set trio stays HTTP-only (no silent
#     "almost encrypted"). The cert/key are operator data kept OUT of git — only
#     the PATHS come from the environment. Unset → HTTP only. ---
# HTTPS_PORT=8443
# SSL_KEYFILE=/path/to/privkey.pem
# SSL_CERTFILE=/path/to/fullchain.pem

# LAN web client (optional). Path INSIDE the container to the static web/
# client; when set, the helper serves it at /app (same-origin → no CORS,
# mounted last so it can't shadow /api/*). The NAS deploy bind-mounts the
# repo-root web/ tree read-only at /app/web, so set this to /app/web to
# enable, or leave empty to disable. Inert static files only — no secret.
WEB_CLIENT_DIR=/app/web

# Playlist profiles (optional). Path INSIDE the container to a JSON file of
# named channel profiles for /api/playlist/{name}.m3u (see
# profiles.example.json for the shape). Operator data — keep it out of git
# (e.g. bind-mount a docs/ops-local/ file). Leave empty for the built-in
# `default` profile only (every live channel). No secret.
PROFILES_FILE=

# Renderer HLS stream (optional; headless-container version). Path INSIDE the
# container to the shared volume the renderer writes its HLS to; when set, the
# helper serves the playlist + segments at /api/stream (for VLC / Apple TV).
# The NAS deploy mounts the shared `mymts-stream` volume read-only at /stream,
# so set this to /stream to enable, or leave empty to disable. No secret.
STREAM_DIR=

# Plain-HTTP HLS stream port (optional). A strict tvOS client (VLC on Apple TV)
# hangs on the helper's self-signed HTTPS, so when this is set (with STREAM_DIR)
# the helper ALSO serves the SAME hardened /api/stream route over plain HTTP on
# this LAN port — the API + /control/ + /app/ stay HTTPS-only. LAN-bound; the
# stream is public video, no secret. Empty → no extra listener. NAS deploy: 8082.
STREAM_HTTP_PORT=
